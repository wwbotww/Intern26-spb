{
  "openapi": "3.1.0",
  "info": {
    "title": "China Post Assistant Agent API",
    "version": "0.3.3-phase6a1",
    "description": "Opt-in V2 JSON/SSE contract with tracking provenance and postage quote basis. Phase 6A-1 optionally separates proxy service auth from anonymous browser ownership. With browser sessions enabled, the dedicated proxy key requires a signed HttpOnly cookie and X-Agent-Session reference for business endpoints; unsafe browser requests also require the configured exact Origin. Other trusted service keys retain key-scoped ownership. Defaults remain V1-only; provider interoperability and full deployment hardening are pending.",
    "x-document-status": "partially-implemented"
  },
  "security": [
    {
      "BearerAuth": []
    },
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/v2/agent/browser-session": {
      "post": {
        "operationId": "establishBrowserSession",
        "summary": "Establish or explicitly reset an anonymous browser identity",
        "description": "Only registered when browser session mode is enabled, and accessible only through its authenticated proxy service role. Exact Origin is mandatory. Missing cookie creates identity; invalid or expired cookie is rejected unless reset=true. Refresh and signing-key rotation preserve the absolute expiry. Cookie is HttpOnly, SameSite=Strict, Path=/, no Domain and Secure (__Host-spb-agent); explicit HTTP loopback development uses spb-agent-local. A reset does not revoke an already copied old token. All responses are no-store. The returned reference is not an authorization credential.",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BrowserSessionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verified anonymous identity; credential is issued only in Set-Cookie",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "Opaque signed HttpOnly credential; never log or persist in client JavaScript"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowserSessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Duplicate security headers"
          },
          "401": {
            "description": "Service authentication or browser cookie invalid / expired"
          },
          "403": {
            "description": "Wrong service role or rejected Origin / Fetch Metadata"
          },
          "422": {
            "description": "Invalid bootstrap schema"
          },
          "429": {
            "description": "Shared gateway rate limit exceeded"
          }
        }
      }
    },
    "/v2/agent/capabilities": {
      "get": {
        "parameters": [
          {
            "$ref": "#/components/parameters/BrowserSessionReference"
          },
          {
            "$ref": "#/components/parameters/AgentClientContract"
          }
        ],
        "operationId": "listAgentCapabilities",
        "summary": "List public Agent capabilities",
        "responses": {
          "200": {
            "description": "Capability metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgentCapability"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/agent/health/ready": {
      "get": {
        "operationId": "getAgentReadiness",
        "summary": "Check the V2 Agent runtime and persistence boundary",
        "security": [],
        "responses": {
          "200": {
            "description": "The Agent can serve at least one capability; janitor degradation remains visible in checks.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentHealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "The Agent API, persistence, checkpoint backend, or every capability is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/agent/messages": {
      "post": {
        "operationId": "sendAgentMessage",
        "summary": "Create or continue an Agent workflow",
        "parameters": [
          {
            "$ref": "#/components/parameters/BrowserSessionReference"
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          {
            "$ref": "#/components/parameters/AgentClientContract"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentMessageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Workflow completed, paused, or streamed as stable public events",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AgentStreamStatusEvent"
                    },
                    {
                      "$ref": "#/components/schemas/AgentStreamStateEvent"
                    },
                    {
                      "$ref": "#/components/schemas/AgentStreamInputRequiredEvent"
                    },
                    {
                      "$ref": "#/components/schemas/AgentStreamResultEvent"
                    },
                    {
                      "$ref": "#/components/schemas/AgentStreamDeltaEvent"
                    },
                    {
                      "$ref": "#/components/schemas/AgentStreamDoneEvent"
                    },
                    {
                      "$ref": "#/components/schemas/AgentStreamErrorEvent"
                    }
                  ]
                },
                "x-sse-event-order": "status, state, input_required|result, delta?, done; error is terminal"
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "502": {
            "description": "Runtime output failed the public API contract",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          },
          "504": {
            "description": "Workflow exceeded the API run timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/agent/conversations/{conversation_id}": {
      "delete": {
        "operationId": "deleteAgentConversation",
        "summary": "Delete a workflow and its checkpoints",
        "parameters": [
          {
            "$ref": "#/components/parameters/BrowserSessionReference"
          },
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Conversation deletion accepted"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      },
      "get": {
        "operationId": "readAgentConversation",
        "summary": "Read an owned durable snapshot without executing or extending candidate expiry",
        "parameters": [
          {
            "$ref": "#/components/parameters/BrowserSessionReference"
          },
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/AgentClientContract"
          }
        ],
        "responses": {
          "200": {
            "description": "Durable state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "BrowserSessionReference": {
        "name": "X-Agent-Session",
        "in": "header",
        "required": false,
        "description": "Required only for the configured browser proxy role, together with a valid signed cookie. Must equal bootstrap session_ref; 409 on missing or stale reference. This is not a bearer credential. Unsafe browser methods also require the configured exact Origin; cross-site Fetch Metadata is rejected.",
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "AgentClientContract": {
        "name": "X-Agent-Contract",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "const": "product-price-v1"
        },
        "description": "Required for browser clients in catalog_v2 mode. Missing/old contract returns 409 before SSE or state writes. Service credentials and V1 are unchanged."
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "BrowserSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reset": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "BrowserSessionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_ref",
          "expires_at"
        ],
        "properties": {
          "session_ref": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Intent": {
        "type": "string",
        "enum": [
          "policy",
          "device_price",
          "product_price",
          "tracking",
          "delivery_time",
          "postage",
          "unknown"
        ]
      },
      "PublicIntent": {
        "type": "string",
        "enum": [
          "policy",
          "device_price",
          "product_price",
          "tracking",
          "delivery_time",
          "postage"
        ]
      },
      "AgentPhase": {
        "type": "string",
        "enum": [
          "new",
          "understanding",
          "clarifying",
          "collecting",
          "ready",
          "executing",
          "validating",
          "recovering",
          "responding",
          "waiting_user",
          "completed",
          "handoff",
          "failed"
        ]
      },
      "AgentMessageRequest": {
        "type": "object",
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "message"
            ]
          },
          {
            "required": [
              "explicit_intent"
            ]
          },
          {
            "required": [
              "price_selection"
            ]
          }
        ],
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "message": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Required when creating a conversation; may be null when selecting an intent for an interrupted conversation."
          },
          "explicit_intent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Intent"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "unknown is not accepted. In catalog_v2 mode, use product_price; device_price remains a historical result type."
          },
          "confirm_overwrite": {
            "type": "boolean",
            "default": false,
            "description": "Explicitly confirms replacement of a conflicting slot value."
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "When true, returns the versioned text/event-stream projection documented on the 200 response."
          },
          "price_selection": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PriceSelectionInput"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Requires conversation_id; excludes message, explicit_intent and confirm_overwrite. Token is bound to owner/conversation/query/conditions and expires within 10 minutes."
          }
        }
      },
      "RequiredInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "label",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "region",
              "choice"
            ]
          },
          "validation_hint": {
            "type": "string",
            "default": ""
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "price_candidates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceCandidateOption"
            },
            "maxItems": 20,
            "default": []
          }
        }
      },
      "AgentSourceResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_type",
          "source_name"
        ],
        "properties": {
          "source_type": {
            "type": "string",
            "enum": [
              "fake_gateway",
              "external_api",
              "unknown"
            ]
          },
          "source_name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$"
          },
          "source_profile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{0,128}$",
            "default": ""
          },
          "queried_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "history_completeness": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "unknown"
            ],
            "default": "unknown"
          }
        }
      },
      "PostageFeeResponse": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "registration",
              "insurance",
              "declared_value",
              "inspection",
              "customs",
              "fuel",
              "return_receipt",
              "password_delivery",
              "printing",
              "handling"
            ],
            "type": "string"
          },
          "amount": {
            "pattern": "^(0|[1-9][0-9]{0,8})\\.[0-9]{2}$",
            "type": "string"
          },
          "included_in_amount": {
            "enum": [
              "yes",
              "no",
              "unknown"
            ],
            "type": "string"
          }
        },
        "required": [
          "kind",
          "amount",
          "included_in_amount"
        ],
        "type": "object"
      },
      "PostageSourceResponse": {
        "additionalProperties": false,
        "description": "Quotation observation: deliberately no tracking history semantics.",
        "properties": {
          "source_type": {
            "enum": [
              "fake_gateway",
              "external_api"
            ],
            "type": "string"
          },
          "source_name": {
            "pattern": "^[A-Za-z0-9_.-]{1,128}$",
            "type": "string"
          },
          "source_profile": {
            "pattern": "^[A-Za-z0-9_.-]{1,128}$",
            "type": "string"
          },
          "queried_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "source_type",
          "source_name",
          "source_profile",
          "queried_at"
        ],
        "type": "object"
      },
      "PostageQuoteBasisResponse": {
        "additionalProperties": false,
        "description": "Versioned public allowlist. No pricing identity, hashes or billing IDs.",
        "properties": {
          "schema_version": {
            "const": "1",
            "default": "1",
            "type": "string"
          },
          "amount_kind": {
            "enum": [
              "total",
              "standard",
              "customer"
            ],
            "type": "string"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          },
          "product_code": {
            "pattern": "^[A-Za-z0-9_.-]{1,128}$",
            "type": "string"
          },
          "scope": {
            "const": "domestic_actual_weight_no_extras",
            "type": "string"
          },
          "is_estimate": {
            "const": true,
            "type": "boolean"
          },
          "fees": {
            "items": {
              "$ref": "#/components/schemas/PostageFeeResponse"
            },
            "type": "array"
          },
          "source": {
            "$ref": "#/components/schemas/PostageSourceResponse"
          }
        },
        "required": [
          "amount_kind",
          "currency",
          "product_code",
          "scope",
          "is_estimate",
          "source"
        ],
        "type": "object"
      },
      "AgentResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "status"
        ],
        "properties": {
          "type": {
            "$ref": "#/components/schemas/PublicIntent"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "partial",
              "need_more_info",
              "no_match",
              "failed"
            ]
          },
          "data": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "For product_price success/partial, validate ProductPriceResponseData (strict whitelist); no_match has null data. Other result types retain their existing payloads."
          },
          "reason_code": {
            "type": "string",
            "default": ""
          },
          "provenance": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgentSourceResponse"
            },
            "default": [],
            "description": "Allowlisted tracking sources, including no_match. Empty for historical responses and other capabilities. Configuration declarations, not provider authentication or freshness guarantees."
          },
          "quote_basis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PostageQuoteBasisResponse"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Allowlisted basis for successful postage only. Absent/null means unknown legacy basis; never infer currency, fees, pricing principal or source. Source time must match data.queried_at."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "product_price"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ProductPriceResponseData"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        ]
      },
      "AgentResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "conversation_id",
          "turn_id",
          "phase",
          "reply",
          "next_action",
          "required_inputs",
          "warnings"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "turn_id": {
            "type": "string",
            "format": "uuid"
          },
          "phase": {
            "$ref": "#/components/schemas/AgentPhase"
          },
          "intent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Intent"
              },
              {
                "type": "null"
              }
            ]
          },
          "reply": {
            "type": "string"
          },
          "next_action": {
            "type": "string",
            "enum": [
              "collect_slots",
              "clarify_intent",
              "complete",
              "handoff",
              "failed"
            ]
          },
          "required_inputs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequiredInput"
            }
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentResult"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "failure": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentFailure"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AgentCapability": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intent",
          "display_name",
          "available",
          "required_inputs"
        ],
        "properties": {
          "intent": {
            "$ref": "#/components/schemas/PublicIntent"
          },
          "display_name": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "capability_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "required_inputs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequiredInput"
            },
            "default": []
          }
        }
      },
      "AgentHealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service",
          "version",
          "phase",
          "checks"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "not_ready"
            ]
          },
          "service": {
            "type": "string",
            "const": "spb-assistant-agent-v2"
          },
          "version": {
            "type": "string"
          },
          "phase": {
            "type": "integer",
            "const": 4
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "ready",
                "not_ready",
                "degraded",
                "starting",
                "disabled"
              ]
            },
            "description": "Fixed coarse statuses for agent_api, persistence, checkpoint, janitor, and capability.<intent>."
          }
        }
      },
      "AgentStreamStatusEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "request_id",
          "stage",
          "message"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1"
          },
          "request_id": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "const": "accepted"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "AgentStreamStateEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "request_id",
          "conversation_id",
          "turn_id",
