{
  "openapi": "3.1.0",
  "info": {
    "title": "China Post Assistant Agent API",
    "version": "0.3.0-phase4d",
    "description": "Phase 4D V2 JSON/SSE contract with operational readiness and compatibility-adapted V1 policy/device tools. Routes remain behind explicit Agent dependency injection while real logistics adapters and production composition are completed.",
    "x-document-status": "partially-implemented"
  },
  "security": [
    {
      "BearerAuth": []
    },
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/v2/agent/capabilities": {
      "get": {
        "operationId": "listAgentCapabilities",
        "summary": "List public Agent capabilities",
        "responses": {
          "200": {
            "description": "Capability metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgentCapability"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/agent/health/ready": {
      "get": {
        "operationId": "getAgentReadiness",
        "summary": "Check the V2 Agent runtime and persistence boundary",
        "security": [],
        "responses": {
          "200": {
            "description": "The Agent can serve at least one capability; janitor degradation remains visible in checks.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentHealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "The Agent API, persistence, checkpoint backend, or every capability is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/agent/messages": {
      "post": {
        "operationId": "sendAgentMessage",
        "summary": "Create or continue an Agent workflow",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentMessageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Workflow completed, paused, or streamed as stable public events",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/AgentStreamStatusEvent" },
                    { "$ref": "#/components/schemas/AgentStreamStateEvent" },
                    { "$ref": "#/components/schemas/AgentStreamInputRequiredEvent" },
                    { "$ref": "#/components/schemas/AgentStreamResultEvent" },
                    { "$ref": "#/components/schemas/AgentStreamDeltaEvent" },
                    { "$ref": "#/components/schemas/AgentStreamDoneEvent" },
                    { "$ref": "#/components/schemas/AgentStreamErrorEvent" }
                  ]
                },
                "x-sse-event-order": "status, state, input_required|result, delta?, done; error is terminal"
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "502": {
            "description": "Runtime output failed the public API contract",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          },
          "504": {
            "description": "Workflow exceeded the API run timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/agent/conversations/{conversation_id}": {
      "delete": {
        "operationId": "deleteAgentConversation",
        "summary": "Delete a workflow and its checkpoints",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Conversation deletion accepted"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "Intent": {
        "type": "string",
        "enum": [
          "policy",
          "device_price",
          "tracking",
          "delivery_time",
          "postage",
          "unknown"
        ]
      },
      "PublicIntent": {
        "type": "string",
        "enum": [
          "policy",
          "device_price",
          "tracking",
          "delivery_time",
          "postage"
        ]
      },
      "AgentPhase": {
        "type": "string",
        "enum": [
          "new",
          "understanding",
          "clarifying",
          "collecting",
          "ready",
          "executing",
          "validating",
          "recovering",
          "responding",
          "waiting_user",
          "completed",
          "handoff",
          "failed"
        ]
      },
      "AgentMessageRequest": {
        "type": "object",
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "message"
            ]
          },
          {
            "required": [
              "explicit_intent"
            ]
          }
        ],
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "message": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Required when creating a conversation; may be null when selecting an intent for an interrupted conversation."
          },
          "explicit_intent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Intent"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "unknown is not accepted as an explicit user choice."
          },
          "confirm_overwrite": {
            "type": "boolean",
            "default": false,
            "description": "Explicitly confirms replacement of a conflicting slot value."
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "When true, returns the versioned text/event-stream projection documented on the 200 response."
          }
        }
      },
      "RequiredInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "label",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "region",
              "choice"
            ]
          },
          "validation_hint": {
            "type": "string",
            "default": ""
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      },
      "AgentResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "status"
        ],
        "properties": {
          "type": {
            "$ref": "#/components/schemas/PublicIntent"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "partial",
              "need_more_info",
              "no_match",
              "failed"
            ]
          },
          "data": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Provisional discriminated result payload; finalized after external API review."
          },
          "reason_code": {
            "type": "string",
            "default": ""
          }
        }
      },
      "AgentResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "conversation_id",
          "turn_id",
          "phase",
          "reply",
          "next_action",
          "required_inputs",
          "warnings"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "turn_id": {
            "type": "string",
            "format": "uuid"
          },
          "phase": {
            "$ref": "#/components/schemas/AgentPhase"
          },
          "intent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Intent"
              },
              {
                "type": "null"
              }
            ]
          },
          "reply": {
            "type": "string"
          },
          "next_action": {
            "type": "string",
            "enum": [
              "collect_slots",
              "clarify_intent",
              "complete",
              "handoff",
              "failed"
            ]
          },
          "required_inputs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequiredInput"
            }
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentResult"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "failure": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentFailure"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AgentCapability": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intent",
          "display_name",
          "available",
          "required_inputs"
        ],
        "properties": {
          "intent": {
            "$ref": "#/components/schemas/PublicIntent"
          },
          "display_name": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "capability_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "required_inputs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequiredInput"
            },
            "default": []
          }
        }
      },
      "AgentHealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service",
          "version",
          "phase",
          "checks"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "not_ready"
            ]
          },
          "service": {
            "type": "string",
            "const": "spb-assistant-agent-v2"
          },
          "version": {
            "type": "string"
          },
          "phase": {
            "type": "integer",
            "const": 4
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "ready",
                "not_ready",
                "degraded",
                "starting",
                "disabled"
              ]
            },
            "description": "Fixed coarse statuses for agent_api, persistence, checkpoint, janitor, and capability.<intent>."
          }
        }
      },
      "AgentStreamStatusEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "request_id",
          "stage",
          "message"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1"
          },
          "request_id": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "const": "accepted"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "AgentStreamStateEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "request_id",
          "conversation_id",
          "turn_id",
          "phase",
          "next_action"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1"
          },
          "request_id": {
            "type": "string"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "turn_id": {
            "type": "string",
            "format": "uuid"
          },
          "phase": {
            "$ref": "#/components/schemas/AgentPhase"
          },
          "intent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Intent"
              },
              {
                "type": "null"
              }
            ]
          },
          "next_action": {
            "type": "string",
            "enum": [
              "collect_slots",
              "clarify_intent",
              "complete",
              "handoff",
              "failed"
            ]
          }
        }
      },
      "AgentStreamInputRequiredEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "request_id",
          "conversation_id",
          "turn_id",
          "required_inputs"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1"
          },
          "request_id": {
            "type": "string"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "turn_id": {
            "type": "string",
            "format": "uuid"
          },
          "required_inputs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequiredInput"
            }
          }
        }
      },
      "AgentStreamResultEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "request_id",
          "conversation_id",
          "turn_id",
          "warnings"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1"
          },
          "request_id": {
            "type": "string"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "turn_id": {
            "type": "string",
            "format": "uuid"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentResult"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "failure": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentFailure"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AgentStreamDeltaEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "request_id",
          "conversation_id",
          "turn_id",
          "content"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1"
          },
          "request_id": {
            "type": "string"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "turn_id": {
            "type": "string",
            "format": "uuid"
          },
          "content": {
            "type": "string"
          }
        }
      },
      "AgentStreamDoneEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "response"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1"
          },
          "response": {
            "$ref": "#/components/schemas/AgentResponse"
          }
        }
      },
      "AgentStreamErrorEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "request_id",
          "code",
          "message",
          "http_status",
          "retryable"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1"
          },
          "request_id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "http_status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "retryable": {
            "type": "boolean",
            "default": false
          },
          "retry_after_seconds": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        }
      },
      "AgentFailure": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "code",
          "retryable"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "retry_after_seconds": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "request_id",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "retry_after_seconds": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "Conversation does not exist or is not visible to the caller",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conversation or idempotency conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Workflow persistence or required capability is unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
}
