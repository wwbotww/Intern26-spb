{
  "name": "spb-chat-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "audit:dependencies": "npm audit --include=dev --audit-level=moderate --registry=https://registry.npmjs.org",
    "generate:agent-types": "node scripts/generate-agent-api-types.mjs",
    "check:agent-types": "node scripts/generate-agent-api-types.mjs --check"
  },
  "dependencies": {
    "dompurify": "^3.2.0",
    "marked": "^16.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.0"
  }
}
