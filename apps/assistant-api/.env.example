ASSISTANT_HOST=0.0.0.0
ASSISTANT_PORT=8081
ASSISTANT_MAX_CONCURRENCY=5
ASSISTANT_LOG_LEVEL=info
ASSISTANT_LOG_JSON=true

# Demo 服务调用密钥。使用逗号分隔轮换中的多个 Key。
ASSISTANT_AUTH_ENABLED=true
ASSISTANT_API_KEYS=replace-with-a-random-service-key
ASSISTANT_RATE_LIMIT_ENABLED=true
ASSISTANT_RATE_LIMIT_REQUESTS=60
ASSISTANT_RATE_LIMIT_WINDOW_SECONDS=60
ASSISTANT_MAX_REQUEST_BODY_BYTES=1048576
ASSISTANT_METRICS_ENABLED=true

# T3: default-off, single-process V2. Requires auth and an absolute SQLite path.
# Create the protected parent directory; run only one worker per database.
ASSISTANT_AGENT_ENABLED=false
ASSISTANT_AGENT_DATABASE_PATH=
# 6A-2: require a CLI-initialized private store and a lifetime process lease.
# Use /absolute/private-store/agent.db; default off for legacy local demos.
# A marked managed directory always enforces the guard, even if this flag is false.
ASSISTANT_AGENT_MANAGED_STORAGE_ENABLED=false
ASSISTANT_AGENT_CONVERSATION_TTL_SECONDS=1800
ASSISTANT_AGENT_REQUEST_TIMEOUT_SECONDS=30

# 6A-1: default-off anonymous browser identity, not user login.
# Proxy key must be one ASSISTANT_API_KEYS entry and match the Nginx key.
# Signing key must be an independent random secret (32-512 bytes); never VITE_*.
ASSISTANT_AGENT_BROWSER_SESSION_ENABLED=false
ASSISTANT_AGENT_BROWSER_PROXY_API_KEY=
ASSISTANT_AGENT_BROWSER_SIGNING_KEY=
ASSISTANT_AGENT_BROWSER_PREVIOUS_SIGNING_KEY=
ASSISTANT_AGENT_BROWSER_PUBLIC_ORIGIN=
ASSISTANT_AGENT_BROWSER_COOKIE_SECURE=true
ASSISTANT_AGENT_BROWSER_SESSION_TTL_SECONDS=1800

# T4 approval/contract confirmation is required before enabling live traffic.
# No automatic fixture fallback, retries stay in LangGraph. Never expose to VITE_*.
ASSISTANT_TRACKING_ENABLED=false
ASSISTANT_TRACKING_BASE_URL=
ASSISTANT_TRACKING_PATH=interface
ASSISTANT_TRACKING_SEND_ID=
ASSISTANT_TRACKING_RECEIVE_ID=JDPT
ASSISTANT_TRACKING_MSG_KIND=
ASSISTANT_TRACKING_SIGNING_SYSTEM_ID=
ASSISTANT_TRACKING_EXPECTED_RESPONSE_RECEIVE_ID=
ASSISTANT_TRACKING_TIMEZONE=
ASSISTANT_TRACKING_PROVINCE_NO=99
# Explicitly select postal-tracking-doc-2019-v1 only after reviewing its assumptions.
ASSISTANT_TRACKING_PROFILE=
ASSISTANT_TRACKING_TIMEOUT_SECONDS=5
ASSISTANT_TRACKING_MAX_RESPONSE_BYTES=1048576

# Phase 5E: opt-in V2 telemetry; no prompts/state/slot values in spans.
# The endpoint is an exact OTLP HTTP traces URL, not a base URL.
ASSISTANT_OTEL_ENABLED=false
ASSISTANT_OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces
ASSISTANT_OTEL_SAMPLE_RATIO=0.1
ASSISTANT_OTEL_EXPORT_TIMEOUT_SECONDS=2

# 阶段 2 模型补齐：仅在显式装配的 Agent 入口使用，默认保留离线规则模式。
# 设置 enabled=true 后，规则无法可靠决策的输入会发送给 DeepSeek。
# Key 属于模型供应商；不是上面的服务鉴权 Key，也不自动读取 RAG 的模型 Key。
ASSISTANT_QUERY_MODEL_ENABLED=false
ASSISTANT_QUERY_MODEL_BASE_URL=https://api.deepseek.com
ASSISTANT_QUERY_MODEL_API_KEY=
ASSISTANT_QUERY_MODEL_NAME=deepseek-v4-flash
ASSISTANT_QUERY_MODEL_TIMEOUT_SECONDS=8
ASSISTANT_QUERY_MODEL_MAX_TOKENS=768
ASSISTANT_QUERY_MODEL_MAX_RESPONSE_BYTES=65536
ASSISTANT_QUERY_MODEL_MAX_CONCURRENCY=2

# 阶段 3：通过 HTTP 黑盒调用现有政策 RAG 服务，不导入其 Python 实现。
ASSISTANT_RAG_BASE_URL=http://rag-api:8080
ASSISTANT_RAG_API_KEY=replace-with-rag-service-key
ASSISTANT_RAG_TIMEOUT_SECONDS=120
ASSISTANT_RAG_HEALTH_TIMEOUT_SECONDS=5
ASSISTANT_RAG_TOP_K=5
ASSISTANT_RAG_CANDIDATE_K=40
ASSISTANT_RAG_VERIFY_TLS=true

# 阶段 2：设备价格库只读连接。生产环境应使用仅有 SELECT 权限的独立账号。
# 密码包含特殊字符时需要进行 URL 编码。
ASSISTANT_MYSQL_DSN=mysql+pymysql://readonly_user:replace-me@mysql-host:3306/device_price?charset=utf8mb4
ASSISTANT_MYSQL_POOL_SIZE=5
ASSISTANT_MYSQL_CONNECT_TIMEOUT_SECONDS=5
ASSISTANT_MYSQL_QUERY_TIMEOUT_SECONDS=10
ASSISTANT_PRICE_CANDIDATE_LIMIT=5000
ASSISTANT_PRICE_RESULT_LIMIT=50
ASSISTANT_PRICE_MATCH_THRESHOLD=65
