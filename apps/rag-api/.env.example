RAG_SERVICE_NAME=spb-rag-api
RAG_HOST=0.0.0.0
RAG_PORT=8080
RAG_MAX_CONCURRENCY=5
RAG_LOG_LEVEL=info
RAG_LOG_JSON=true
RAG_INITIALIZE_ON_STARTUP=true

# 业务 API 鉴权、限流与监控。
RAG_AUTH_ENABLED=true
RAG_API_KEYS=
RAG_RATE_LIMIT_ENABLED=true
RAG_RATE_LIMIT_REQUESTS=60
RAG_RATE_LIMIT_WINDOW_SECONDS=60
RAG_MAX_REQUEST_BODY_BYTES=1048576
RAG_METRICS_ENABLED=true

# 在线进程应使用 Milvus 只读账号。
RAG_MILVUS_URI=
RAG_MILVUS_TOKEN=
RAG_MILVUS_DATABASE=aisv
RAG_MILVUS_COLLECTION=spb_policy_chunks
RAG_MILVUS_TIMEOUT_SECONDS=10
RAG_MILVUS_CONSISTENCY_LEVEL=Bounded

RAG_EMBEDDING_MODEL=moka-ai/m3e-base
RAG_EMBEDDING_DEVICE=cpu
RAG_SEARCH_DEFAULT_TOP_K=8
RAG_SEARCH_MAX_TOP_K=20
RAG_SEARCH_CANDIDATE_K=40
RAG_SEARCH_MAX_CANDIDATE_K=100
RAG_SEARCH_RRF_K=60
RAG_SEARCH_DENSE_EF=64

# 轻量 Cross-Encoder 重排序与第一道相关性门槛。
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_RERANK_DEVICE=cpu
RAG_RERANK_FETCH_K=20
RAG_RERANK_BATCH_SIZE=8
RAG_RERANK_MAX_LENGTH=512
RAG_RERANK_MAX_CONCURRENCY=1
# 0.5 仅为 Demo 初始值，必须使用本项目正负样本重新标定。
RAG_RERANK_MIN_SCORE=0.5
RAG_RERANK_SHADOW_MODE=false

# DeepSeek 问答；默认使用低延迟的非思考模式。
RAG_DEEPSEEK_BASE_URL=https://api.deepseek.com
RAG_DEEPSEEK_API_KEY=
RAG_DEEPSEEK_MODEL=deepseek-v4-flash
RAG_DEEPSEEK_THINKING=disabled
RAG_DEEPSEEK_TIMEOUT_SECONDS=90
RAG_DEEPSEEK_MAX_TOKENS=1200
RAG_DEEPSEEK_TEMPERATURE=0.1
RAG_CHAT_CONTEXT_MAX_CHARS=16000

# DeepSeek 第二道证据充分性门槛。
RAG_RELEVANCE_JUDGE_ENABLED=true
RAG_RELEVANCE_JUDGE_MAX_SOURCES=5
RAG_RELEVANCE_JUDGE_SOURCE_MAX_CHARS=1200
RAG_RELEVANCE_JUDGE_MAX_TOKENS=180
RAG_RELEVANCE_JUDGE_ATTEMPTS=2
