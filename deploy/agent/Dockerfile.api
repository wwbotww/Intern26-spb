# Fixed upstream manifest; intentionally separate from all previously built Demo images.
ARG UV_BASE=ghcr.io/astral-sh/uv@sha256:e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58
FROM ${UV_BASE} AS builder
ENV UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/app/.venv UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY apps/offline-pipeline/pyproject.toml apps/offline-pipeline/pyproject.toml
COPY apps/rag-api/pyproject.toml apps/rag-api/pyproject.toml
COPY apps/assistant-api/pyproject.toml apps/assistant-api/pyproject.toml
COPY eval/pyproject.toml eval/pyproject.toml
COPY packages/contracts/pyproject.toml packages/contracts/pyproject.toml
RUN uv sync --frozen --no-dev --package spb-assistant-api --no-install-workspace
COPY apps/assistant-api/src apps/assistant-api/src
RUN uv sync --frozen --no-dev --package spb-assistant-api --no-editable

FROM ${UV_BASE} AS runtime
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY --from=builder --chown=10001:10001 /app/.venv /app/.venv
RUN install -d -m 0700 -o 10001 -g 10001 /var/lib/spb-runtime /var/lib/spb-backups /var/lib/spb-restored
USER 10001:10001
STOPSIGNAL SIGTERM
ENTRYPOINT ["/app/.venv/bin/python"]
CMD ["-m", "spb_assistant_api.deployed_app"]
