FROM node@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS build
WORKDIR /app
COPY apps/chat-web/package.json apps/chat-web/package-lock.json ./
RUN npm ci --include=dev --engine-strict --no-audit
COPY apps/chat-web/ ./
# Run the isolated test entry in the same Node 22 environment as this build.
RUN npm test
ARG AGENT_UI_MODE=agent
RUN case "$AGENT_UI_MODE" in agent) browser=true;; legacy) browser=false;; *) exit 2;; esac; \
    VITE_ASSISTANT_UI_MODE="$AGENT_UI_MODE" VITE_AGENT_BROWSER_SESSION="$browser" npm run build
RUN printf '%s' "$AGENT_UI_MODE" > /app/ui-mode

FROM nginx@sha256:4a73073bd557c65b759505da037898b61f1be6cbcc3c2c3aeac22d2a470c1752
COPY --from=build /app/dist /usr/share/nginx/html
COPY --from=build /app/ui-mode /opt/agent/ui-mode
COPY deploy/agent/nginx/ /opt/agent/nginx/
USER 10001:10001
STOPSIGNAL SIGQUIT
ENTRYPOINT ["/bin/sh", "/opt/agent/nginx/entrypoint.sh"]
